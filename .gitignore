# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Backend virtual environment
backend/.venv/

# Runtime data - user-uploaded/generated images
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/sample.jpg
!backend/uploads/lena.png
backend/outputs/*
!backend/outputs/.gitkeep

# Downloaded model weights (e.g. YuNet face detector), cached on first use
backend/models/*
!backend/models/.gitkeep

# Auto-install cache marker for custom node dependencies (see engine/discovery.py)
.requirements_installed

# Environment/secrets
.env
.env.*

# Editors
.vscode/
.idea/
*.swp

# OS junk files
.DS_Store
Thumbs.db
